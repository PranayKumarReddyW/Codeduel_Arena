# ==========================================
# CodeDuel Arena - Environment Configuration
# ==========================================

# Port for the frontend/nginx (defaults to 80 for production)
PORT=80

# Port for Spring Boot backend (defaults to 8088)
BACKEND_PORT=8088

# Persistent database storage directory (for H2 file database)
DATA_DIR=./data

# Optional: Remote database (e.g., AWS RDS PostgreSQL or MySQL)
# Leave blank to use built-in persistent disk H2 database
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-endpoint.amazonaws.com:5432/codeduel
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_secure_password

# Judge0 Code Execution Engine (Configured for self-hosted instance on 54.196.209.169)
# Default self-hosted port is 2358. RapidAPI or custom endpoint can be set here.
JUDGE0_API_URL=http://54.196.209.169:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_API_WAIT=true

# Spring Boot Logging Level (INFO, WARN, DEBUG)
LOGGING_LEVEL_APP=INFO

